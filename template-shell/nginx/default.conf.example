# Example Nginx config for the Main Shell static build.
# Replace {{CONTEXT_PATH}} with the path segment without leading slash (e.g. admin).

server {
    listen       80;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # SPA under context path
    location /{{CONTEXT_PATH}}/ {
        try_files $uri $uri/ /{{CONTEXT_PATH}}/index.html;
    }

    location = /{{CONTEXT_PATH}} {
        return 302 /{{CONTEXT_PATH}}/;
    }

    # Optional: proxy API to Gateway (adjust upstream in real deployments)
    # location /api/ {
    #     proxy_pass http://gateway:8080/;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # }
}
