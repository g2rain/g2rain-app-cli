{
  "name": "create-g2rain-app",
  "version": "1.0.0",
  "description": "CLI to scaffold G2rain frontend-app sub-apps and frontend-shell Main Shells, plus generate / build-config tooling.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g2rain/g2rain-app-cli.git"
  },
  "homepage": "https://github.com/g2rain/g2rain-app-cli#readme",
  "bugs": {
    "url": "https://github.com/g2rain/g2rain/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "g2rain",
    "cli",
    "scaffold",
    "vue",
    "vite",
    "qiankun",
    "micro-frontend",
    "codegen"
  ],
  "contributors": [
    {
      "name": "Jagger",
      "email": "g2rain_developer@163.com",
      "url": "https://www.g2rain.com/"
    },
    {
      "name": "Alpha",
      "url": "https://www.g2rain.com/"
    }
  ],
  "type": "module",
  "bin": {
    "g2rain-app": "dist/index.js",
    "create-g2rain-app": "dist/index.js"
  },
  "files": [
    "dist",
    "template",
    "template-shell",
    "template-shell-legacy",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-templates.mjs",
    "sync:template": "node scripts/sync-app-template.mjs",
    "sync:template:shell": "node scripts/sync-shell-template.mjs",
    "sync:templates": "npm run sync:template && npm run sync:template:shell",
    "verify:template-snapshots": "node scripts/verify-template-snapshots.mjs",
    "prepublishOnly": "node scripts/assert-ci-publish.mjs && node scripts/check-embedded-template.mjs && npm run build",
    "dev": "tsx src/index.ts",
    "test": "npm run build && node --experimental-test-isolation=none --test test/*.test.mjs"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "fs-extra": "^11.2.0",
    "kleur": "^4.1.5",
    "prompts": "^2.4.2",
    "ts-morph": "^23.0.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.19.0",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  }
}
